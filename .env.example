# ── Postgres (n8n's own DB + Jorip app state) ────────────────────────
POSTGRES_USER=jorip
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=jorip

# ── n8n ──────────────────────────────────────────────────────────────
# Generate once and keep it: losing this invalidates every stored credential.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Set to the public URL the tunnel gives you, WITH trailing slash.
# Without this, WhatsApp callbacks point at localhost and silently fail.
#   WEBHOOK_URL=https://some-words-trycloudflare-com/
WEBHOOK_URL=http://localhost:5678/

# Basic auth so a stranger on a tunnel URL cannot open the editor.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# ── LLM (Gemini API free tier — https://aistudio.google.com/apikey) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_ESCALATE=gemini-2.5-pro
GEMINI_EMBED_MODEL=text-embedding-004

# ── WhatsApp Business Platform, sandbox test number ──────────────────
# Meta → your app → WhatsApp → API Setup. No business verification needed
# for the test number; you may send to ~5 numbers you verify yourself.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any string you invent; must match what you paste into the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string

# ── CRM export ───────────────────────────────────────────────────────
# Google Cloud → Service account → download JSON, then share the Sheet
# with the service account's email address.
GOOGLE_CREDENTIALS_JSON=./secrets/gcp-sa.json
GOOGLE_SHEETS_ID=

# ── Fallback channel if Meta stalls: Telegram (instant, free) ────────
TELEGRAM_BOT_TOKEN=
