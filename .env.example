# ── Postgres (n8n's own DB + Jorip app state) ────────────────────────
POSTGRES_USER=jorip
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=jorip

# ── n8n ──────────────────────────────────────────────────────────────
# Generate once and keep it: losing this invalidates every stored credential.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Leave this on loopback or the compose service name. It is what n8n calls its OWN webhook
# paths when something inside n8n needs to reach them; on the WhatsApp path the brain reaches
# n8n by service name on the compose network, so no public URL is needed.
#
# It used to say "set this to the tunnel URL". Doing that now publishes
# /webhook/jorip-pipeline, which authenticates nothing — see docs/TUNNEL.md. The URL Meta needs
# is the brain's, configured in Meta's dashboard, not something in this file.
WEBHOOK_URL=http://localhost:5678/

# Basic auth so a stranger on a tunnel URL cannot open the editor.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# ── LLM ──────────────────────────────────────────────────────────────
# Do not copy model names out of docs or blog posts. Run
#   node scripts/probe-models.mjs
# and configure what actually answers — availability by key tier changes
# faster than any table of them does.
GEMINI_API_KEY=
GEMINI_MODEL_ROUTE=gemini-3.1-flash-lite
GEMINI_MODEL_REPLY=gemini-3-flash-preview
GEMINI_MODEL_HEAVY=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=400
GEMINI_THINKING_BUDGET=0
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768

# ── WhatsApp Business Platform, sandbox test number ──────────────────
# Meta → your app → WhatsApp → API Setup. No business verification needed
# for the test number; you may send to ~5 numbers you verify yourself.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any string you invent; must match what you paste into the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string

# ── The brain service (scripts/brain-server.mjs, compose `brain`) ─────
# n8n and the brain talk to each other on the compose network. This token is
# presented as x-jorip-token to POST /reply; without it /reply refuses to run,
# because an open turn endpoint on a box that holds your keys is an open proxy to
# a paid API. Generate once:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
JORIP_SHARED_SECRET=
JORIP_BRAIN_URL=http://brain:8788
# Per model call. Two of these can happen in a turn (extract, then repair), so
# keep 2 × this value comfortably under Vercel's maxDuration or a slow upstream
# returns a gateway error instead of the fallback sentence.
JORIP_MODEL_TIMEOUT_MS=12000

# ── CRM export ───────────────────────────────────────────────────────
# Google Cloud → Service account → download JSON, then share the Sheet
# with the service account's email address.
GOOGLE_CREDENTIALS_JSON=./secrets/gcp-sa.json
GOOGLE_SHEETS_ID=

# ── Fallback channel if Meta stalls: Telegram (instant, free) ────────
TELEGRAM_BOT_TOKEN=

# Where the verified webhook hands off: the n8n pipeline trigger.
JORIP_PIPELINE_URL=http://n8n:5678/webhook/jorip-pipeline
JORIP_HANDOFF_TIMEOUT_MS=8000
